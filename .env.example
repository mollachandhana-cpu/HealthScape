# Never commit a real .env file or any credentials.
# Local Docker Compose database values
DB_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_DATABASE_PASSWORD
DB_ROOT_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_ROOT_PASSWORD

# Application database (TiDB Cloud or MySQL). JDBC URL, not mysql:// URI.
DATABASE_URL=jdbc:mysql://YOUR_TIDB_HOST:4000/healthscape?sslMode=VERIFY_IDENTITY
DATABASE_USER=YOUR_TIDB_USERNAME
DATABASE_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD

# Bootstrap official account
HS_ADMIN_USER=official
HS_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD

# Optional generative AI briefing. Leave unset to use explainable rule-based insights only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PORT=8080
DDL_AUTO=update
SHOW_SQL=false
